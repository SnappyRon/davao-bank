{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$DAVAO_AGENT_GUARD\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
