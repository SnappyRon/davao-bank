# ==============================================================================
# Davao Bank — Environment Configuration Template
# Phase 1: Project Setup & Architecture
#
# COPY this file to .env.local (in apps/admin) and .env (in apps/mobile),
# or root .env as needed. NEVER commit real secret keys to source control.
# ==============================================================================

# Supabase Project Connection (Local or Hosted)
# Local Supabase default URL is typically http://127.0.0.1:54321
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Mobile App (Expo) Public Variables
# Expo only exposes environment variables prefixed with EXPO_PUBLIC_ to the client bundle
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Web (Next.js) Public Variables
# Next.js only exposes environment variables prefixed with NEXT_PUBLIC_ to the browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Server-Only Secret Key
# WARNING: NEVER prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_.
# This key bypasses Row Level Security and must only be read in Server Components,
# Server Actions, or Route Handlers. Never expose this to client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Seed User Password (Development Default Only)
# WARNING: Must be changed before any public demonstration or staging/production deployment.
SEED_PASSWORD=Password123!
